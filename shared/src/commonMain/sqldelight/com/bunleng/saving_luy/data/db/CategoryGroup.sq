CREATE TABLE categoryGroup (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    sortOrder INTEGER NOT NULL
);

selectAll:
SELECT * FROM categoryGroup ORDER BY sortOrder;

count:
SELECT COUNT(*) FROM categoryGroup;

insert:
INSERT INTO categoryGroup(id, name, sortOrder) VALUES (?, ?, ?);

nextSortOrder:
SELECT COALESCE(MAX(sortOrder) + 1, 0) FROM categoryGroup;

rename:
UPDATE categoryGroup SET name = ? WHERE id = ?;

delete:
DELETE FROM categoryGroup WHERE id = ?;
