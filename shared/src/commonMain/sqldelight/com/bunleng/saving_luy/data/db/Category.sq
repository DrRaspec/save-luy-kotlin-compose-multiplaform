CREATE TABLE category (
    id TEXT NOT NULL PRIMARY KEY,
    groupId TEXT NOT NULL REFERENCES categoryGroup(id),
    name TEXT NOT NULL,
    sortOrder INTEGER NOT NULL
);

-- Budget screen order: by group, then by category within the group.
selectAll:
SELECT category.*
FROM category
JOIN categoryGroup ON categoryGroup.id = category.groupId
ORDER BY categoryGroup.sortOrder, category.sortOrder;

insert:
INSERT INTO category(id, groupId, name, sortOrder) VALUES (?, ?, ?, ?);

nextSortOrder:
SELECT COALESCE(MAX(sortOrder) + 1, 0) FROM category WHERE groupId = ?;

rename:
UPDATE category SET name = ? WHERE id = ?;

delete:
DELETE FROM category WHERE id = ?;

countByGroup:
SELECT COUNT(*) FROM category WHERE groupId = ?;
